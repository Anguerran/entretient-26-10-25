datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CLIENT
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  
  firstName       String
  lastName        String
  profilImage     String?
  passwordHash    String?
  googleId        String?
  
  role            Role

  // Correction: Suppression des arguments fields/references ici. C'est l'autre côté de la relation qui les définit.
  // La relation manager:branchManaged doit avoir un nom explicite pour éviter l'ambiguïté.
  branchManaged   Branch?  @relation("BranchManager") 
  branchManagedId String?  @unique

  customerProfile Customer?

  account         Account?
  refreshTokens   RefreshToken[]
}

model Branch {
  id               String    @id @default(cuid())
  name             String
  address          String
  department       String

  // Correction: Ajout du nom explicite et maintien des arguments fields/references ici.
  manager          User?     @relation("BranchManager", fields: [managerId], references: [id])
  managerId        String?   @unique

  customers        Customer[]
}

model Customer {
  id              String   @id @default(cuid())
  lastName        String
  firstName       String
  dateOfBirth     DateTime
  address         String
  phone           String

  branch          Branch   @relation(fields: [branchId], references: [id])
  branchId        String

  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique

  policies        InsurancePolicy[]
}

model InsurancePolicy {
  id              String   @id @default(cuid())
  policyNumber    String   @unique
  policyType      String
  startDate       DateTime
  endDate         DateTime
  annualPremium   Float

  client          Customer @relation(fields: [clientId], references: [id])
  clientId        String
}

model Account {
  id      String    @id @default(cuid())
  user    User      @relation(fields: [userId], references: [id])
  userId  String    @unique
}


model RefreshToken {
  id            String    @id @default(cuid())
  hashedToken   String
  userId        String
  expiresAt     DateTime
  revoked       Boolean   @default(false)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}