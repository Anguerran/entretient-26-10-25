{
  "preset": "ts-jest",

  "testEnvironment": "node",

  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json",
        "useESM": true 
      }
    ]
  },

  "testMatch": [
    "**/__tests__/**/*.test.ts",
    "**/?(*.)+(spec|test).ts"
  ],

  "roots": [
    "<rootDir>/src",
    "<rootDir>/__tests__"
  ],
  
  "moduleFileExtensions": [
    "ts",
    "js",
    "json",
    "node"
  ]
}