# Node.js dependencies
node_modules/

# Logs
logs
*.log
*.log.*

# Environment files
.env

# npm package lock file (if you don't want to track changes to package-lock.json)
package-lock.json

# Optional npm cache directory
.npm/

# Build output directories
dist/
build/
tmp/

# TypeScript output (if using TypeScript)
*.tsbuildinfo

# IDE or editor specific files
.vscode/
.idea/

# Operating system files (like .DS_Store for macOS)
.DS_Store

# OS generated files
Thumbs.db
